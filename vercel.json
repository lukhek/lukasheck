{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "de"
        }
      ],
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^de.*"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        }
      ],
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "^(DE|AT|CH)$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        },
        {
          "type": "header",
          "key": "accept-language"
        }
      ],
      "destination": "/de/",
      "permanent": false
    }
  ]
}